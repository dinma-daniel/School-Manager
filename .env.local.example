# Which model does the extraction: ollama | openai | claude
# Default is ollama — free, local, no account needed.
EXTRACTOR=ollama

# --- ollama (free, runs on your machine) --------------------------------
# Install from ollama.com, then: ollama pull qwen3:8b
OLLAMA_MODEL=qwen3:8b
# Ollama defaults EVERY model to a 4096-token context and silently drops the
# rest of the page. Keep this high or deadlines go missing.
OLLAMA_NUM_CTX=32768
# OLLAMA_HOST=http://127.0.0.1:11434
# OLLAMA_TIMEOUT_MS=300000

# --- openai-compatible (Groq, Hugging Face, OpenRouter, LM Studio) ------
# VERIFIED WORKING on Groq's free tier with these exact settings:
#   EXTRACTOR=openai
#   EXTRACTOR_BASE_URL=https://api.groq.com/openai/v1
#   EXTRACTOR_MODEL=openai/gpt-oss-120b
#   EXTRACTOR_API_KEY=gsk_...
#   EXTRACTOR_MAX_CHARS=16000
#   EXTRACTOR_MAX_PAGES=2
#
# Groq's free tier allows 8,000 tokens per MINUTE, which is the real limit
# here — not the model's 131k context. That works out at roughly one school
# per minute. Raising EXTRACTOR_MAX_CHARS much past 16000 returns HTTP 413.
# Works with anything speaking the OpenAI chat API. Examples:
#   Hugging Face  https://router.huggingface.co/v1
#   Groq          https://api.groq.com/openai/v1
#   OpenRouter    https://openrouter.ai/api/v1
#   LM Studio     http://localhost:1234/v1
# EXTRACTOR_BASE_URL=https://router.huggingface.co/v1
# EXTRACTOR_MODEL=Qwen/Qwen3-8B
# EXTRACTOR_API_KEY=hf_...
# EXTRACTOR_MAX_CHARS=60000

# --- claude (paid, most accurate) ---------------------------------------
# Key from https://console.anthropic.com/settings/keys
# Haiku costs roughly 2p a school; Opus about ten times that.
# ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_MODEL=claude-haiku-4-5
